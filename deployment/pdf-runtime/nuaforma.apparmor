# SPDX-License-Identifier: Apache-2.0
# Enforcing container policy; mounts not explicitly listed remain denied.
abi <abi/3.0>,
#include <tunables/global>

profile nuaforma-runtime flags=(attach_disconnected,mediate_deleted) {
  # OS capability sets still control privileges; no host capabilities are granted.
  capability,
  file,
  network,
  deny network inet raw,
  deny network inet6 raw,
  deny network packet,
  deny network vsock,
  deny network alg,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=nuaforma-runtime,
  ptrace (trace,tracedby,read,readby) peer=nuaforma-runtime,

  deny /proc/* w,
  deny /proc/{acpi,bus,driver,fs,irq,scsi,sys}/** wklx,
  deny /proc/{sysrq-trigger,kcore,mem,kmem} rwklx,
  deny /sys/** wklx,
  deny /sys/{firmware,kernel/security,devices/virtual/powercap}/** r,

  # Bubblewrap's private staging root and two root pivots.
  mount options=(rw,silent,rslave) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /tmp/,
  mount options=(rw,silent,rbind) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  mount options=(rw,silent,rbind) /oldroot/proc/ -> /proc/,
  mount options=(rw,silent,rprivate) -> /oldroot/,
  umount /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /,

  # Only the immutable renderer, validator resources and private request root.
  mount options=(rw,silent,bind) /oldroot/opt/nuaforma/renderer/ -> /newroot/,
  mount options=(rw,silent,rbind) /oldroot/opt/nuaforma/renderer/ -> /newroot/,
  mount options=(rw,silent,bind) /oldroot/opt/java/openjdk/ -> /newroot/validator/java/,
  mount options=(rw,silent,rbind) /oldroot/opt/java/openjdk/ -> /newroot/validator/java/,
  mount options=(rw,silent,bind) /oldroot/opt/nuaforma/pdf-validation/ -> /newroot/validator/lib/,
  mount options=(rw,silent,rbind) /oldroot/opt/nuaforma/pdf-validation/ -> /newroot/validator/lib/,
  mount options=(rw,silent,bind) /oldroot/opt/nuaforma/verapdf-validation/ -> /newroot/tmp/verapdf/,
  mount options=(rw,silent,rbind) /oldroot/opt/nuaforma/verapdf-validation/ -> /newroot/tmp/verapdf/,
  mount options=(rw,silent,bind) /oldroot/tmp/nuaforma-[^/]*/ -> /newroot/work/,
  mount options=(rw,silent,rbind) /oldroot/tmp/nuaforma-[^/]*/ -> /newroot/work/,

  # Private proc/dev/tmp, not host filesystems or arbitrary device nodes.
  mount fstype=proc options=(rw,nosuid,nodev,noexec) -> /newroot/proc/,
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /newroot/{dev,tmp}/,
  mount fstype=devpts options=(rw,nosuid,noexec) -> /newroot/dev/pts/,
  mount options=(rw,silent,bind) /oldroot/dev/{null,zero,full,random,urandom,tty} -> /newroot/dev/{null,zero,full,random,urandom,tty},

  # Read-only remounts never authorize a writable renderer or validator root.
  mount options=(ro,remount,bind,silent,nosuid,nodev) -> /newroot/,
  mount options=(ro,remount,bind,silent,nosuid,nodev,relatime) -> /newroot/,
  mount options=(ro,remount,bind,silent,nosuid,nodev) -> /newroot/validator/{java,lib}/,
  mount options=(ro,remount,bind,silent,nosuid,nodev,relatime) -> /newroot/validator/{java,lib}/,
  mount options=(ro,remount,bind,silent,nosuid,nodev) -> /newroot/tmp/verapdf/,
  mount options=(ro,remount,bind,silent,nosuid,nodev,relatime) -> /newroot/tmp/verapdf/,
}
