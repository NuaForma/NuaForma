{
  "info": {
    "name": "NuaForma examples",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local evaluation collection. Set baseUrl, use the extracted postman folder as your working directory, then check capabilities before generating. Includes 7 complete scenarios and local assets. No credentials or automatic file-saving scripts."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Version",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/version",
        "description": "Packaged version; not a readiness check."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Capabilities",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/capabilities",
        "description": "Check available.writeFormats for PDF readiness, not only declared formats."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Assess final PDF request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/assess",
        "description": "Preflight readiness/options only; this does not upload or validate the template.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"format\": \"docx\"\n  },\n  \"output\": {\n    \"format\": \"pdf\",\n    \"options\": {\n      \"profile\": \"pdfa-3b\"\n    }\n  },\n  \"filename\": \"example\",\n  \"data\": {\n    \"reference\": \"NF-001\",\n    \"issuedOn\": \"2026-10-13\",\n    \"status\": \" APPROVED \",\n    \"customer\": {\n      \"name\": \" Ada Lovelace \",\n      \"company\": \"Example Studio\",\n      \"email\": \"ada@example.invalid\",\n      \"phone\": null,\n      \"nickname\": null,\n      \"address\": {\n        \"city\": \"Utrecht\",\n        \"country\": \"Netherlands\"\n      }\n    },\n    \"description\": \"Regular project delivery\",\n    \"currency\": \"EUR\",\n    \"total\": 875.5,\n    \"lines\": [\n      {\n        \"description\": \"Template design\",\n        \"quantity\": 1,\n        \"unitPrice\": 500,\n        \"amount\": 500,\n        \"optional\": false\n      },\n      {\n        \"description\": \"Document delivery\",\n        \"quantity\": 3,\n        \"unitPrice\": 125.1667,\n        \"amount\": 375.5,\n        \"optional\": true\n      }\n    ],\n    \"showProjects\": true,\n    \"projects\": [\n      {\n        \"name\": \"Customer onboarding\",\n        \"active\": true,\n        \"team\": \"Delivery\",\n        \"owner\": {\n          \"name\": \"Sam\"\n        },\n        \"tasks\": [\n          {\n            \"code\": \"NF-T01\",\n            \"name\": \"Prepare template\",\n            \"done\": true,\n            \"blocked\": false,\n            \"hasNotes\": true,\n            \"notes\": [\n              \"Design review complete\",\n              \"Images and tables retained\"\n            ]\n          },\n          {\n            \"code\": \"EXT-02\",\n            \"name\": \"Confirm delivery\",\n            \"done\": false,\n            \"blocked\": true,\n            \"hasNotes\": false,\n            \"notes\": null\n          }\n        ]\n      },\n      {\n        \"name\": \"Future rollout\",\n        \"active\": false,\n        \"team\": \"Operations\",\n        \"owner\": {\n          \"name\": null\n        },\n        \"tasks\": []\n      }\n    ],\n    \"delivery\": {\n      \"filename\": \"summary.pdf\"\n    },\n    \"message\": \"Ready for the next review.\",\n    \"image\": null\n  },\n  \"options\": {\n    \"locale\": \"en-GB\",\n    \"timeZone\": \"Europe/Amsterdam\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - OpenAPI JSON",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/openapi.json",
        "description": "Download the service OpenAPI JSON definition."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - OpenAPI YAML",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/yaml"
          }
        ],
        "url": "{{baseUrl}}/openapi.yaml",
        "description": "Download the equivalent OpenAPI YAML definition."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/yaml\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Final document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "Approved status, two work items and active/paused projects. Exercises nested if → each → if → each → if content. Expected: Two work rows; complete and blocked tasks; review note; paused-project message; no watermark.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/01-final-pdfa3b.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Draft with a watermark",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "A null email and a missing phone use fallbacks; uppercase URGENT still matches. More nested notes and an in-progress task. Expected: DRAFT NF-002 watermark, awaiting-approval and urgent text, safe email/phone fallbacks.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/02-draft-watermark.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Null, missing and empty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "Blank email, null address/message, missing nickname, empty work rows and an excluded project section. Header row remains. Expected: A header-only table, blank-email warning, address/message fallbacks, no project details.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/03-null-empty-standard.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Opaque draft watermark",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "The same template uses opaque JPEG images and an opaque text watermark. PDF/A-1b cannot accept transparency. Expected: PDF/A-1b with DRAFT NF-004 watermark at full opacity; no transparency flattening.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/04-opaque-pdfa1b.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Editable Word output",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "Choose the DOCX provider explicitly. The nested logic and table rows use the same data language. Expected: An editable Word document with a resolved draft watermark and retained tables/images.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/05-editable-word.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Empty list and literal text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "An empty project list expands to no projects. A data string containing a placeholder is not evaluated a second time. Expected: No repeated project content; the literal text {customer.name} remains in the message.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/06-empty-projects-pdfa2b.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Base64 image from data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/pdf"
          }
        ],
        "url": "{{baseUrl}}/api/v1/documents",
        "description": "A real Base64 PNG in data.image is inserted by image(60, 25, true). Expected: A teal IMAGE FROM JSON illustration, 60 mm wide and 20 mm high, preserving its 3:1 ratio. Other scenarios supply null and add no image.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "request",
              "type": "file",
              "src": "assets/07-base64-image-pdfa3b.json",
              "contentType": "application/json"
            },
            {
              "key": "template",
              "type": "file",
              "src": "assets/nuaforma-example-template.docx",
              "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Expected content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"); });"
            ]
          }
        }
      ]
    }
  ]
}
