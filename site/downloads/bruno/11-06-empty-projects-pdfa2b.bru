meta {
  name: Empty list and literal text
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/06-empty-projects-pdfa2b.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/pdf
}

assert {
  res.status: eq 200
}

docs {
  An empty project list expands to no projects. A data string containing a placeholder is not evaluated a second time. Expected: No repeated project content; the literal text {customer.name} remains in the message.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
