meta {
  name: OpenAPI YAML
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/openapi.yaml
  body: none
  auth: none
}

headers {
  Accept: application/yaml
}

assert {
  res.status: eq 200
}

docs {
  Download the equivalent OpenAPI YAML definition.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
