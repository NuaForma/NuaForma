meta {
  name: Editable Word output
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/05-editable-word.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/vnd.openxmlformats-officedocument.wordprocessingml.document
}

assert {
  res.status: eq 200
}

docs {
  Choose the DOCX provider explicitly. The nested logic and table rows use the same data language. Expected: An editable Word document with a resolved draft watermark and retained tables/images.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
