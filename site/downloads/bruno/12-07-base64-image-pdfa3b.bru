meta {
  name: Base64 image from data
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/07-base64-image-pdfa3b.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/pdf
}

assert {
  res.status: eq 200
}

docs {
  A real Base64 PNG in data.image is inserted by image(60, 25, true). Expected: A teal IMAGE FROM JSON illustration, 60 mm wide and 20 mm high, preserving its 3:1 ratio. Other scenarios supply null and add no image.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
