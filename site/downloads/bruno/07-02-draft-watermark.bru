meta {
  name: Draft with a watermark
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/02-draft-watermark.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/pdf
}

assert {
  res.status: eq 200
}

docs {
  A null email and a missing phone use fallbacks; uppercase URGENT still matches. More nested notes and an in-progress task. Expected: DRAFT NF-002 watermark, awaiting-approval and urgent text, safe email/phone fallbacks.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
