meta {
  name: Final document
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  request: @file(assets/01-final-pdfa3b.json) @contentType(application/json)
  template: @file(assets/nuaforma-example-template.docx) @contentType(application/vnd.openxmlformats-officedocument.wordprocessingml.document)
}

headers {
  Accept: application/pdf
}

assert {
  res.status: eq 200
}

docs {
  Approved status, two work items and active/paused projects. Exercises nested if → each → if → each → if content. Expected: Two work rows; complete and blocked tasks; review note; paused-project message; no watermark.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
