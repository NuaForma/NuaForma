meta {
  name: Version
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/version
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Packaged version; not a readiness check.
  Save a successful document response as PDF or DOCX. Errors are JSON diagnostics.
}
